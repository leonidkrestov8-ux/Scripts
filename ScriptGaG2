-- Подключаем Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- ===================== НАСТРОЙКИ =====================
local Settings = {
    AutoHarvest = false,
    AutoPlant = false,
    AutoSell = false,
    AutoBuy = false,
    HarvestRange = 50,
    TargetSeed = "Bamboo"
}

-- ===================== ОСНОВНЫЕ ФУНКЦИИ =====================

-- Получить свой участок
local function getMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    
    for _, plot in ipairs(plots:GetChildren()) do
        local owner = plot:FindFirstChild("Owner")
        if owner and owner.Value == game.Players.LocalPlayer.Name then
            return plot
        end
    end
    return nil
end

-- 1. АВТО-СБОР
local function AutoHarvest()
    local plot = getMyPlot()
    if not plot then return end
    
    local crops = plot:FindFirstChild("Crops")
    if not crops then return end
    
    for _, crop in ipairs(crops:GetChildren()) do
        local stage = crop:FindFirstChild("Stage")
        if stage and stage.Value >= 3 then
            local prompt = crop:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                fireproximityprompt(prompt)
                task.wait(0.1)
            end
        end
    end
end

-- 2. АВТО-ПОСАДКА
local function AutoPlant()
    local plot = getMyPlot()
    if not plot then return end
    
    local dirtPlots = plot:FindFirstChild("DirtPlots")
    if not dirtPlots then return end
    
    for _, dirt in ipairs(dirtPlots:GetChildren()) do
        local hasCrop = dirt:FindFirstChild("HasCrop")
        if hasCrop and hasCrop.Value == false then
            local plantRemote = game:GetService("ReplicatedStorage"):FindFirstChild("PlantSeed", true)
            if plantRemote then
                plantRemote:FireServer(dirt, Settings.TargetSeed)
                task.wait(0.2)
            end
        end
    end
end

-- 3. АВТО-ПРОДАЖА
local function AutoSell()
    local sellRemote = game:GetService("ReplicatedStorage"):FindFirstChild("SellCrops", true)
    if sellRemote then
        sellRemote:FireServer()
    end
end

-- 4. АВТО-ПОКУПКА СЕМЯН
local function AutoBuySeeds()
    local buyRemote = game:GetService("ReplicatedStorage"):FindFirstChild("BuySeeds", true)
    if buyRemote then
        buyRemote:FireServer(Settings.TargetSeed, 10)
    end
end

-- ===================== СОЗДАНИЕ МЕНЮ =====================

local Window = Rayfield:CreateWindow({
    Name = "🌱 Grow a Garden 2",
    LoadingTitle = "Загрузка...",
    LoadingSubtitle = "Автор: Лёня",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "GrowGarden2",
        FileName = "Settings"
    }
})

-- ===================== ВКЛАДКА: ФЕРМА =====================

local FarmTab = Window:CreateTab("🚜 Ферма")

-- Секция: Авто-сбор
FarmTab:CreateSection("🌾 Сбор урожая")

FarmTab:CreateToggle({
    Name = "Авто-сбор",
    CurrentValue = false,
    Flag = "AutoHarvest",
    Callback = function(Value)
        Settings.AutoHarvest = Value
        print("Авто-сбор: " .. tostring(Value))
    end
})

FarmTab:CreateSlider({
    Name = "Радиус сбора",
    Range = {10, 100},
    Increment = 5,
    Suffix = "блоков",
    CurrentValue = 50,
    Flag = "HarvestRange",
    Callback = function(Value)
        Settings.HarvestRange = Value
    end
})

-- Секция: Авто-посадка
FarmTab:CreateSection("🌱 Посадка")

FarmTab:CreateToggle({
    Name = "Авто-посадка",
    CurrentValue = false,
    Flag = "AutoPlant",
    Callback = function(Value)
        Settings.AutoPlant = Value
        print("Авто-посадка: " .. tostring(Value))
    end
})

FarmTab:CreateDropdown({
    Name = "Семена для посадки",
    Options = {"Bamboo", "Wheat", "Carrot", "Potato", "Tomato", "Strawberry"},
    CurrentOption = "Bamboo",
    Flag = "SeedType",
    Callback = function(Option)
        Settings.TargetSeed = Option
        print("Выбраны семена: " .. Option)
    end
})

-- Секция: Авто-продажа
FarmTab:CreateSection("💰 Продажа")

FarmTab:CreateToggle({
    Name = "Авто-продажа",
    CurrentValue = false,
    Flag = "AutoSell",
    Callback = function(Value)
        Settings.AutoSell = Value
        print("Авто-продажа: " .. tostring(Value))
    end
})

-- Секция: Авто-покупка
FarmTab:CreateSection("🛒 Покупка")

FarmTab:CreateToggle({
    Name = "Авто-покупка семян",
    CurrentValue = false,
    Flag = "AutoBuy",
    Callback = function(Value)
        Settings.AutoBuy = Value
        print("Авто-покупка: " .. tostring(Value))
    end
})

-- ===================== ВКЛАДКА: ДОПОЛНИТЕЛЬНО =====================

local ExtraTab = Window:CreateTab("⚙️ Дополнительно")

ExtraTab:CreateButton({
    Name = "📌 Телепорт к участку",
    Callback = function()
        local plot = getMyPlot()
        if plot then
            local pos = plot:FindFirstChild("Position")
            if pos then
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = pos.Value
                print("✅ Телепорт к участку")
            end
        end
    end
})

ExtraTab:CreateButton({
    Name = "🏪 Телепорт в магазин",
    Callback = function()
        local shop = workspace:FindFirstChild("Shop")
        if shop then
            local pos = shop:FindFirstChild("Position")
            if pos then
                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = pos.Value
                print("✅ Телепорт в магазин")
            end
        end
    end
})

ExtraTab:CreateSlider({
    Name = "Скорость ходьбы",
    Range = {16, 100},
    Increment = 1,
    Suffix = "",
    CurrentValue = 16,
    Flag = "WalkSpeed",
    Callback = function(Value)
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = Value
        end
    end
})

-- ===================== ЦИКЛ АВТОМАТИЗАЦИИ =====================

task.spawn(function()
    while task.wait(0.5) do
        if Settings.AutoHarvest then
            AutoHarvest()
        end
        
        if Settings.AutoPlant then
            AutoPlant()
        end
        
        if Settings.AutoSell then
            AutoSell()
        end
        
        if Settings.AutoBuy then
            AutoBuySeeds()
        end
    end
end)

