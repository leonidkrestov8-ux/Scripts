    if enterPressed then
        local value = tonumber(speedInput.Text)
        if value then SetSpeed(value) else speedDisplay.Text = "❌ Введите число!" end
    end
end)

-- Кнопка полета
flyButton.MouseButton1Click:Connect(function()
    ToggleFly()
end)

-- Enter в поле скорости полета
flySpeedInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local value = tonumber(flySpeedInput.Text)
        if value and value > 0 then
            flySpeed = value
            if flySpeed > 200 then flySpeed = 200 end
            flySpeedInput.Text = tostring(flySpeed)
            print("✅ Скорость полета: " .. flySpeed)
        else
            flySpeedInput.Text = tostring(flySpeed)
        end
    end
end)

-- Обновление при смене персонажа
player.CharacterAdded:Connect(function(newChar)
    char = newChar
    humanoid = char:WaitForChild("Humanoid")
    rootPart = char:WaitForChild("HumanoidRootPart")
    
    -- Восстанавливаем скорость
    local currentSpeed = tonumber(speedInput.Text)
    if currentSpeed then SetSpeed(currentSpeed) end
    
    -- Если был полет, выключаем
    if flyEnabled then
        ToggleFly()
    end
end)

-- Открытие по нажатию K
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.K then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

