createButton(ChestTab, "📋 СКАН (запомнить тип)", function()
    local char = player.Character
    if not char then return end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    local nearestPrompt = nil
    local nearestDist = math.huge
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent then
                local rootPart = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                if rootPart then
                    local dist = (myRoot.Position - rootPart.Position).Magnitude
                    if dist < nearestDist and dist < 10 then
                        nearestDist = dist
                        nearestPrompt = obj
                    end
                end
            end
        end
    end
    
    if not nearestPrompt then
        chestStatus.Text = "❌ Не нашёл prompt рядом!"
        chestStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    savedChestName = nearestPrompt.Parent.Name
    savedHoldDuration = nearestPrompt.HoldDuration or 0
    
    local promptType = savedHoldDuration > 0 and ("🔒 ЗАЖИМ (" .. savedHoldDuration .. "с)") or "👆 КЛИК"
    
    chestStatus.Text = "✅ " .. savedChestName .. " | " .. promptType
    chestStatus.TextColor3 = Color3.fromRGB(0, 255, 100)
    chestInfo.Text = "Готово к старту"
end)

