            bindInfo.TextColor3 = Color3.fromRGB(0, 255, 100)
        end
        return
    end

    -- Проверка биндов
    local key = input.KeyCode
    if binds[key] then
        local actionName = binds[key]
        if bindActions[actionName] then
            pcall(bindActions[actionName])
        end
        return
    end

    -- Старые клавиши 2-5 (метки)
    if key == Enum.KeyCode.Two then
        doSaveMark1()
    elseif key == Enum.KeyCode.Three then
        doSaveMark2()
    elseif key == Enum.KeyCode.Four then
        doTpMark1()
    elseif key == Enum.KeyCode.Five then
        doTpMark2()
    end
end)

