-- ==================== ФУНКЦИИ ====================
local function applyESP(char)
    if not char then return end
    local oldHl = char:FindFirstChild("XenoESP")
    if oldHl then oldHl:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "XenoESP"
    hl.Adornee = char
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    table.insert(espObjects, hl)
end

local function disableESP()
    for _, esp in ipairs(espObjects) do
        if esp and esp.Parent then esp:Destroy() end
    end
    espObjects = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "XenoESP" then obj:Destroy() end
    end
end

local function findNearestBotWithName(name)
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name == name and obj ~= player.Character then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                if root then
                    local d = (myRoot.Position - root.Position).Magnitude
                    if d < nearestDist then nearestDist = d nearest = obj end
                end
            end
        end
    end
    return nearest
end

-- ==================== ESP БОТОВ ====================
local function isPlayerCharacter(model)
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p.Character == model then return true end
    end
    return false
end

local function addBotEsp(botModel)
    if botEspObjects[botModel] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "XenoBotESP"
    hl.Adornee = botModel
    hl.FillColor = botEspColor
    hl.FillTransparency = 0.4
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = botModel
    botEspObjects[botModel] = hl
end

local function removeBotEsp(botModel)
    if botEspObjects[botModel] then
        if botEspObjects[botModel].Parent then
            botEspObjects[botModel]:Destroy()
        end
        botEspObjects[botModel] = nil
    end
end

local function clearAllBotEsp()
    for model, hl in pairs(botEspObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    botEspObjects = {}
    botEspList = {}
end

local function updateBotEsp()
    if not botEspEnabled then return end
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position
    local seenBots = {}
    botEspList = {}
    
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= player.Character and not isPlayerCharacter(obj) then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local botRoot = obj:FindFirstChild("HumanoidRootPart") 
                    or obj:FindFirstChild("Torso") 
                    or obj:FindFirstChild("UpperTorso")
                if botRoot then
                    local dist = (myPos - botRoot.Position).Magnitude
                    if dist <= botEspRadius then
                        seenBots[obj] = true
                        table.insert(botEspList, {model = obj, root = botRoot, distance = dist})
                        if not botEspObjects[obj] then
                            addBotEsp(obj)
                        else
                            botEspObjects[obj].FillColor = botEspColor
                        end
                    end
                end
            end
        end
    end
    
    -- Сортируем по дистанции (ближние первыми)
    table.sort(botEspList, function(a, b) return a.distance < b.distance end)
    
    for model, hl in pairs(botEspObjects) do
        if not seenBots[model] or not model.Parent then
            removeBotEsp(model)
        end
    end
end

-- ==================== СУНДУКИ (ФИКС) ====================
local function scanChests()
    -- Сначала ищем ближайший ProximityPrompt чтобы узнать имя
    local char = player.Character
    if not char then return false end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    
    local nearestPrompt, nearestDist = nil, math.huge
    -- Ищем через workspace:GetDescendants
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent then
                local rootPart = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                if rootPart then
                    local d = (myRoot.Position - rootPart.Position).Magnitude
                    if d < nearestDist and d < 15 then
                        nearestDist = d
                        nearestPrompt = obj
                    end
                end
            end
        end
    end
    
    if not nearestPrompt then
        return false, "Не нашёл сундук рядом"
    end
    
    -- Сохраняем имя и HoldDuration
    savedChestName = nearestPrompt.Parent.Name
    savedHoldDuration = nearestPrompt.HoldDuration or 0
    
    -- Ищем ВСЕ сундуки с таким же именем
    chestsList = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent.Name == savedChestName then
            local parentHold = obj.HoldDuration or 0
            -- Проверяем тип зажима
            local sameType = false
            if savedHoldDuration > 0 and parentHold > 0 then sameType = true
            elseif savedHoldDuration == 0 and parentHold == 0 then sameType = true end
            
            if sameType then
                local parent = obj.Parent
                local rootPart = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                if rootPart then
                    table.insert(chestsList, {
                        part = rootPart,
                        prompt = obj,
                        holdDuration = parentHold
                    })
                end
            end
        end
    end
    
    currentChestIndex = 1
    return true, savedChestName .. " | " .. #chestsList .. " шт."
end

-- Цикл сбора сундуков
task.spawn(function()
    while true do
        task.wait(0.1)
        
        if farming and #chestsList > 0 then
            local char = player.Character
            if not char then continue end
            local myRoot = char:FindFirstChild("HumanoidRootPart")
            if not myRoot then continue end
            
            -- Проверяем текущий сундук
            if currentChestIndex > #chestsList then
                currentChestIndex = 1
            end
            
            local entry = chestsList[currentChestIndex]
            if not entry or not entry.part or not entry.part.Parent then
                table.remove(chestsList, currentChestIndex)
                if currentChestIndex > #chestsList then currentChestIndex = 1 end
                continue
            end
            
            local chestPart = entry.part
            local prompt = entry.prompt
            local holdDur = entry.holdDuration
            
            if not prompt or not prompt.Parent then
                table.remove(chestsList, currentChestIndex)
                continue
            end
            
            -- Телепорт к сундуку
            myRoot.CFrame = CFrame.new(chestPart.Position + Vector3.new(0, 3, 0))
            task.wait(0.2)
            
            -- Зажим E
            local key = prompt.KeyboardKeyCode or Enum.KeyCode.E
            
            if holdDur > 0 then
                -- ЗАЖИМНОЙ
                vim:SendKeyEvent(true, key, false, game)
                local waitTime = math.max(holdDur + 0.3, 2.5)
                for j = 1, math.ceil(waitTime * 10) do
                    if not farming then break end
                    task.wait(0.1)
                    if not chestPart or not chestPart.Parent then break end
                end
                vim:SendKeyEvent(false, key, false, game)
            else
                -- КЛИК
                vim:SendKeyEvent(true, key, false, game)
                task.wait(0.1)
                vim:SendKeyEvent(false, key, false, game)
                task.wait(0.5)
            end
            
            -- Следующий
            currentChestIndex = currentChestIndex + 1
        end
    end
end)

