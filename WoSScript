local function doPvpTeleport()
    if pvpTarget and pvpTarget.Character then
        local char = player.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        local targetRoot = pvpTarget.Character:FindFirstChild("HumanoidRootPart")
        local hum = pvpTarget.Character:FindFirstChild("Humanoid")
        if myRoot and targetRoot and hum and hum.Health > 0 then
            local look = targetRoot.CFrame.LookVector
            local pos = targetRoot.Position - (look * 6)
            myRoot.CFrame = CFrame.new(Vector3.new(pos.X, targetRoot.Position.Y, pos.Z))
            local head = pvpTarget.Character:FindFirstChild("Head")
            if head then
                cam.CFrame = CFrame.new(cam.CFrame.Position, head.Position)
            end
        end
    end
end

