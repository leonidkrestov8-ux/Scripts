local function enableESPForAll()
    for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
        if otherPlayer ~= player then
            if otherPlayer.Character then applyESP(otherPlayer.Character) end
            local conn = otherPlayer.CharacterAdded:Connect(function(newChar)
                if espEnabled then
                    task.wait(0.5)
                    if newChar and newChar.Parent then applyESP(newChar) end
                end
            end)
            table.insert(espConns, conn)
        end
    end
end

