                return
            end
            local cleanName = string.gsub(name, "[^%w_%-]", "_")
            customModules[cleanName] = code
            if hasFileSystem then saveModuleToDisk(cleanName, code) end
            executeModule(cleanName, code)
            Fluent:Notify({ Title = "✅ Модуль", Content = cleanName .. " запущен", Duration = 3 })
        end
    })

