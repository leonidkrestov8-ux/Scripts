local function tryLogin()
    local password = passBox.Text
    local hwid = getHWID()
    
    if password == "" then
        statusLabel.Text = "❌ Введи пароль!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local role = PASSWORDS[password]
    
    if not role then
        statusLabel.Text = "❌ НЕПРАВИЛЬНЫЙ ПАРОЛЬ!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        
        sendWebhook(
            "❌ НЕПРАВИЛЬНЫЙ ПАРОЛЬ",
            "**Игрок:** `" .. player.Name .. "`\n" ..
            "**UserID:** `" .. player.UserId .. "`\n" ..
            "**HWID:** `" .. hwid .. "`\n" ..
            "**Пароль:** `" .. password .. "`\n" ..
            "**PlaceId:** `" .. game.PlaceId .. "`",
            15158332
        )
        
        task.delay(3, function()
            licenseGui:Destroy()
            error("KSAS: Wrong password")
        end)
        return
    end
    
    statusLabel.Text = "✅ Пароль верный!\nЗагрузка..."
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    
    sendWebhook(
        "✅ УСПЕШНЫЙ ВХОД",
        "**Игрок:** `" .. player.Name .. "`\n" ..
        "**UserID:** `" .. player.UserId .. "`\n" ..
        "**HWID:** `" .. hwid .. "`\n" ..
        "**Роль:** `" .. role .. "`\n" ..
        "**PlaceId:** `" .. game.PlaceId .. "`",
        3066993
    )
    
    task.delay(1, function()
        licenseGui:Destroy()
        launchMainScript()
    end)
end

