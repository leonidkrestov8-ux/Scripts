task.spawn(function()
    while true do
        task.wait(0.1)
        
        if farming and savedChestName then
            local char = player.Character
            if not char then continue end
            local myRoot = char:FindFirstChild("HumanoidRootPart")
            if not myRoot then continue end
            
            local foundChests = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    local parent = obj.Parent
                    if parent and parent.Name == savedChestName then
                        local parentHold = obj.HoldDuration or 0
                        local sameType = false
                        if savedHoldDuration > 0 and parentHold > 0 then
                            sameType = true
                        elseif savedHoldDuration == 0 and parentHold == 0 then
                            sameType = true
                        end
                        
                        if sameType then
                            local rootPart = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                            if rootPart then
                                table.insert(foundChests, {part = rootPart, prompt = obj, holdDuration = parentHold})
                            end
                        end
                    end
                end
            end
            
            if #foundChests > 0 then
                chestInfo.Text = "Сундуков рядом: " .. #foundChests
                
                for i = #foundChests, 1, -1 do
                    if not farming then break end
                    local entry = foundChests[i]
                    if not entry or not entry.part or not entry.part.Parent then continue end
                    
                    local chestPart = entry.part
                    local prompt = entry.prompt
                    local holdDur = entry.holdDuration
                    if not prompt or not prompt.Parent then continue end
                    
                    myRoot.CFrame = CFrame.new(chestPart.Position + Vector3.new(0, 3, 0))
                    task.wait(0.15)
                    
                    local key = prompt.KeyboardKeyCode or Enum.KeyCode.E
                    
                    if holdDur > 0 then
                        game:GetService("VirtualInputManager"):SendKeyEvent(true, key, false, game)
                        local waitTime = math.max(holdDur + 0.3, 2.5)
                        for j = 1, math.ceil(waitTime * 10) do
                            if not farming then break end
                            task.wait(0.1)
                            if not chestPart or not chestPart.Parent then break end
                        end
                        game:GetService("VirtualInputManager"):SendKeyEvent(false, key, false, game)
                    else
                        game:GetService("VirtualInputManager"):SendKeyEvent(true, key, false, game)
                        task.wait(0.1)
                        game:GetService("VirtualInputManager"):SendKeyEvent(false, key, false, game)
                        task.wait(0.3)
                    end
                end
            else
                chestInfo.Text = "Сундуков рядом: 0 | ТП по карте..."
                local allChestPositions = {}
                for _, obj in ipairs(game:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent.Name == savedChestName then
                        local rootPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                        if rootPart then
                            table.insert(allChestPositions, rootPart.Position)
                        end
                    end
                end
                
                local moved = false
                for _, pos in ipairs(allChestPositions) do
                    local visited = false
                    for _, vpos in ipairs(visitedPositions) do
                        if (pos - vpos).Magnitude < 20 then visited = true break end
                    end
                    if not visited then
                        table.insert(visitedPositions, pos)
                        myRoot.CFrame = CFrame.new(pos + Vector3.new(0, 5, 0))
                        chestInfo.Text = "ТП | Посещено: " .. #visitedPositions
                        moved = true
                        break
                    end
                end
                if not moved then visitedPositions = {} end
                task.wait(1)
            end
        end
    end
end)

