    local function findNearestBotWithName(name)
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end
        local nearest, nearestDist = nil, math.huge
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name == name and obj ~= player.Character then
                local hum = obj:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                    if root then
                        local d = (myRoot.Position - root.Position).Magnitude
                        if d < nearestDist then nearestDist = d nearest = obj end
                    end
                end
            end
        end
        return nearest
    end

