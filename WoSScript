    -- МОДУЛИ
    local MODULES_FOLDER = "KSAS_Modules"
    local hasFileSystem = (writefile and readfile and isfile and makefolder and listfiles)
    if hasFileSystem and not isfolder(MODULES_FOLDER) then
        makefolder(MODULES_FOLDER)
    end

    local customModules = {}

    local function loadModulesFromDisk()
        if not hasFileSystem then return end
        customModules = {}
        local files = listfiles(MODULES_FOLDER)
        for _, filePath in ipairs(files) do
            if string.sub(filePath, -4) == ".lua" then
                local success, content = pcall(readfile, filePath)
                if success and content and content ~= "" then
                    local fileName = string.match(filePath, "([^\\/]+)%.lua$") or "Unknown"
                    customModules[fileName] = content
                end
            end
        end
    end

    local function saveModuleToDisk(name, code)
        if not hasFileSystem then return false end
        name = string.gsub(name, "[^%w_%-]", "_")
        local filePath = MODULES_FOLDER .. "/" .. name .. ".lua"
        return pcall(writefile, filePath, code)
    end

    local function executeModule(name, code)
        if not code or code == "" then return end
        local func, err = loadstring(code)
        if not func then
            warn("Ошибка компиляции: " .. tostring(err))
            return
        end
        local env = setmetatable({}, {__index = getfenv()})
        env._G = _G
        env.player = player
        env.cam = cam
        env.uis = uis
        env.runService = runService
        env.vim = game:GetService("VirtualInputManager")
        env.getPlayerRoot = function()
            local char = player.Character
            return char and char:FindFirstChild("HumanoidRootPart")
        end
        env.getNearestBot = findNearestBotWithName
        env.applyESP = applyESP
        env.pvpTeleport = doPvpTeleport
        setfenv(func, env)
        local ok, execErr = pcall(func)
        if not ok then
            warn("Модуль '" .. name .. "': " .. tostring(execErr))
        end
    end

