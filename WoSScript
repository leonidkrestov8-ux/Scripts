        pcall(function()
            for _, obj in ipairs(botModel:GetDescendants()) do
                if obj and obj.Parent and obj:IsA("ProximityPrompt") then
                    if obj.KeyboardKeyCode == Enum.KeyCode.E 
                       and obj.Enabled == true 
                       and obj.MaxActivationDistance > 0 then
                        hasE = true
