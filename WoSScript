local function updatePlayerButtons()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
        if otherPlayer ~= player then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 32)
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
            btn.BackgroundTransparency = 0.3
            btn.BorderSizePixel = 0
            btn.Text = "  " .. otherPlayer.Name
            btn.TextColor3 = Color3.fromRGB(220, 220, 255)
            btn.TextSize = 12
            btn.Font = Enum.Font.Gotham
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Parent = playerList
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 6)
            c.Parent = btn
            btn.MouseButton1Click:Connect(function()
                if stalking and stalkTarget == otherPlayer then
                    stalking = false
                    stalkTarget = nil
                    btn.Text = "  " .. otherPlayer.Name
                    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
                else
                    stalking = true
                    stalkTarget = otherPlayer
                    for _, b in ipairs(playerList:GetChildren()) do
                        if b:IsA("TextButton") then
                            b.Text = b.Text:gsub("🎯 ", "  ")
                            b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
                        end
                    end
                    btn.Text = "  🎯 " .. otherPlayer.Name
                    btn.BackgroundColor3 = MENU_COLOR
                end
            end)
        end
    end
    task.wait()
    playerList.Size = UDim2.new(1, -10, 0, psLayout.AbsoluteContentSize.Y)
    playerScroll.CanvasSize = UDim2.new(0, 0, 0, psLayout.AbsoluteContentSize.Y + 15)
end

