local function applyESP(char)
    if not char then return end
    local oldHl = char:FindFirstChild("XenoESP")
    if oldHl then oldHl:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "XenoESP"
    hl.Adornee = char
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    table.insert(espObjects, hl)
end

local function disableESP()
    for _, esp in ipairs(espObjects) do
        if esp and esp.Parent then esp:Destroy() end
    end
    espObjects = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "XenoESP" then obj:Destroy() end
    end
end

local function findNearestBotWithName(name)
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name == name and obj ~= player.Character then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                if root then
                    local d = (myRoot.Position - root.Position).Magnitude
                    if d < nearestDist then nearestDist = d nearest = obj end
                end
            end
        end
    end
    return nearest
end

-- ==================== PvP ТЕЛЕПОРТ (НЕ ЛОМАЕТ КАМЕРУ) ====================
local function getPvpTargetChar()
    if pvpBotTarget and pvpBotTarget.Parent then
        local hum = pvpBotTarget:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then return pvpBotTarget end
    end
    if pvpTarget and pvpTarget.Character then
        local hum = pvpTarget.Character:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then return pvpTarget.Character end
    end
    if pvpTargetName then
        local newBot = findNearestBotWithName(pvpTargetName)
        if newBot then
            pvpBotTarget = newBot
            return newBot
        end
    end
    return nil
end

local function doPvpTeleport()
    if pvpCooldown then return end
    pvpCooldown = true
    task.delay(0.5, function() pvpCooldown = false end)

    local targetChar = getPvpTargetChar()
    if not targetChar then return end

    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        or targetChar:FindFirstChild("Torso")
        or targetChar:FindFirstChild("UpperTorso")
    if not targetRoot then return end

    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    -- Телепорт за спину
    local look = targetRoot.CFrame.LookVector
    if look.Magnitude < 0.1 then
        look = (targetRoot.Position - myRoot.Position).Unit
    end
    local pos = targetRoot.Position - (look * 6)
    pos = Vector3.new(pos.X, targetRoot.Position.Y, pos.Z)

    -- Телепорт + поворот персонажа лицом к цели
    myRoot.CFrame = CFrame.new(pos, Vector3.new(targetRoot.Position.X, pos.Y, targetRoot.Position.Z))

    -- Плавно крутим камеру через TweenService (НЕ ломает управление)
    local head = targetChar:FindFirstChild("Head")
    if head then
        local targetCF = CFrame.new(cam.CFrame.Position, head.Position)
        local tween = tweenService:Create(
            cam,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {CFrame = targetCF}
        )
        tween:Play()
    end
end

