    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == botTargetName then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                count = count + 1
            end
        end
    end
    
    botStatus.Text = "✅ Запомнено: " .. botTargetName .. "\nБотов на карте: " .. count
    botStatus.TextColor3 = Color3.fromRGB(0, 255, 100)
    botInfo.Text = "Цель: " .. botTargetName .. " | Готово"
end)

