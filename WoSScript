-- Логика котенка на ботов (авто-переключение)
runService.RenderStepped:Connect(function()
    if botStalking and botTargetName then
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        -- Проверяем текущую цель
        local targetValid = false
        if botTarget and botTarget.Parent then
            local hum = botTarget:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local targetRoot = botTarget:FindFirstChild("HumanoidRootPart") or botTarget:FindFirstChild("Torso") or botTarget:FindFirstChild("UpperTorso")
                if targetRoot then
                    targetValid = true
                    
                    -- Телепорт за спину
                    local look = targetRoot.CFrame.LookVector
                    if look.Magnitude < 0.1 then
                        look = (targetRoot.Position - myRoot.Position).Unit
                    end
                    
                    local pos = targetRoot.Position - (look * botDistance)
                    myRoot.CFrame = CFrame.new(Vector3.new(pos.X, targetRoot.Position.Y, pos.Z))
                    
                    botInfo.Text = "Цель: " .. botTarget.Name .. " | HP: " .. math.floor(hum.Health)
                end
            end
        end
        
        -- Если цель умерла или потеряна — ищем новую
        if not targetValid then
            local newTarget, newRoot = findNearestBotWithName(botTargetName)
            if newTarget then
                botTarget = newTarget
                botInfo.Text = "Цель: " .. newTarget.Name .. " | Новая"
            else
                botTarget = nil
                botInfo.Text = "Цель: нет доступных ботов"
            end
        end
    end
end)

