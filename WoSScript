local function doToggleBotStalker()
    botStalking = not botStalking
    if botStalking and botTargetName then
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local nearest = nil
            local nearestDist = math.huge
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj.Name == botTargetName and obj ~= player.Character then
                    local hum = obj:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                        if root then
                            local dist = (myRoot.Position - root.Position).Magnitude
                            if dist < nearestDist then
                                nearestDist = dist
                                nearest = obj
                            end
                        end
                    end
                end
            end
            if nearest then botTarget = nearest end
        end
    end
end

