local function scanChests()
    local char = player.Character
    if not char then return false, "Нет персонажа" end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false, "Нет RootPart" end
    
    local nearestPrompt, nearestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            if parent then
                local rootPart = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                if rootPart then
                    local d = (myRoot.Position - rootPart.Position).Magnitude
                    if d < nearestDist and d < 15 then
                        nearestDist = d
                        nearestPrompt = obj
                    end
                end
            end
        end
    end
    
    if not nearestPrompt then return false, "Не нашёл сундук рядом" end
    
    savedChestName = nearestPrompt.Parent.Name
    savedHoldDuration = nearestPrompt.HoldDuration or 0
    
    chestsList = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent.Name == savedChestName then
            local parentHold = obj.HoldDuration or 0
            local sameType = false
            if savedHoldDuration > 0 and parentHold > 0 then sameType = true
            elseif savedHoldDuration == 0 and parentHold == 0 then sameType = true end
            
            if sameType then
                local parent = obj.Parent
                local rootPart = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                if rootPart then
                    table.insert(chestsList, {part = rootPart, prompt = obj, holdDuration = parentHold})
                end
            end
        end
    end
    
    currentChestIndex = 1
    return true, savedChestName .. " | " .. #chestsList .. " шт."
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if farming and #chestsList > 0 then
            local char = player.Character
            if not char then continue end
            local myRoot = char:FindFirstChild("HumanoidRootPart")
            if not myRoot then continue end
            
            if currentChestIndex > #chestsList then currentChestIndex = 1 end
            
            local entry = chestsList[currentChestIndex]
            if not entry or not entry.part or not entry.part.Parent then
                table.remove(chestsList, currentChestIndex)
                if currentChestIndex > #chestsList then currentChestIndex = 1 end
                continue
            end
            
            local chestPart = entry.part
            local prompt = entry.prompt
            local holdDur = entry.holdDuration
            
            if not prompt or not prompt.Parent then
                table.remove(chestsList, currentChestIndex)
                continue
            end
            
            myRoot.CFrame = CFrame.new(chestPart.Position + Vector3.new(0, 3, 0))
            task.wait(0.2)
            
            local key = prompt.KeyboardKeyCode or Enum.KeyCode.E
            
            if holdDur > 0 then
                vim:SendKeyEvent(true, key, false, game)
                local waitTime = math.max(holdDur + 0.3, 2.5)
                for j = 1, math.ceil(waitTime * 10) do
                    if not farming then break end
                    task.wait(0.1)
                    if not chestPart or not chestPart.Parent then break end
                end
                vim:SendKeyEvent(false, key, false, game)
            else
                vim:SendKeyEvent(true, key, false, game)
                task.wait(0.1)
                vim:SendKeyEvent(false, key, false, game)
                task.wait(0.5)
            end
            
            currentChestIndex = currentChestIndex + 1
        end
    end
end)

