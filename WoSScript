-- ==================== PvP ТЕЛЕПОРТ ====================
local function getPvpTargetChar()
    if pvpBotTarget and pvpBotTarget.Parent then
        local hum = pvpBotTarget:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then return pvpBotTarget end
    end
    if pvpTarget and pvpTarget.Character then
        local hum = pvpTarget.Character:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then return pvpTarget.Character end
    end
    if pvpTargetName then
        local newBot = findNearestBotWithName(pvpTargetName)
        if newBot then
            pvpBotTarget = newBot
            return newBot
        end
    end
    return nil
end

local function doPvpTeleport(targetChar)
    if pvpCooldown then return end
    pvpCooldown = true
    task.delay(0.5, function() pvpCooldown = false end)

    if not targetChar then
        targetChar = getPvpTargetChar()
    end
    if not targetChar then return end

    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        or targetChar:FindFirstChild("Torso")
        or targetChar:FindFirstChild("UpperTorso")
    if not targetRoot then return end

    local char = player.Character
    if not char then return end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local look = targetRoot.CFrame.LookVector
    if look.Magnitude < 0.1 then
        look = (targetRoot.Position - myRoot.Position).Unit
    end
    local pos = targetRoot.Position - (look * 6)
    pos = Vector3.new(pos.X, targetRoot.Position.Y + 1, pos.Z)

    local startPos = myRoot.Position
    for i = 1, 5 do
        local t = i / 5
        myRoot.CFrame = CFrame.new(startPos:Lerp(pos, t))
        task.wait(0.02)
    end

    task.wait(0.1)

    myRoot.CFrame = CFrame.new(myRoot.Position, Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z))

    local head = targetChar:FindFirstChild("Head")
    if head and cam then
        cam.CameraSubject = head
        task.delay(0.3, function()
            local currentChar = player.Character
            local hum = currentChar and currentChar:FindFirstChild("Humanoid")
            if cam and hum then cam.CameraSubject = hum end
        end)
    end
end

