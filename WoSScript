    local function updateBotEsp()
        if not botEspEnabled then return end
        pcall(function()
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end
            local myPos = myRoot.Position
            local seenBots = {}
            botEspList = {}
            local count = 0
            for _, obj in ipairs(workspace:GetDescendants()) do
                if count >= BOT_ESP_LIMIT then break end
                if obj and obj.Parent and obj:IsA("Model") and obj ~= player.Character and not isPlayerCharacter(obj) then
                    local hum = obj:FindFirstChild("Humanoid")
                    if hum and hum.Health and hum.Health > 0 then
                        local botRoot = obj:FindFirstChild("HumanoidRootPart")
                            or obj:FindFirstChild("Torso")
                            or obj:FindFirstChild("UpperTorso")
                        if botRoot and botRoot.Position then
                            local dist = (myPos - botRoot.Position).Magnitude
                            if dist <= botEspRadius and botHasE(obj) then
                                count = count + 1
                                seenBots[obj] = true
                                table.insert(botEspList, {model = obj, root = botRoot, distance = dist})
                                if not botEspObjects[obj] then
                                    addBotEsp(obj)
                                else
                                    pcall(function()
                                        if botEspObjects[obj] and botEspObjects[obj].Parent then
                                            botEspObjects[obj].FillColor = botEspColor
                                        end
                                    end)
                                end
                            end
                        end
                    end
                end
            end
            pcall(function()
                table.sort(botEspList, function(a, b) return a.distance < b.distance end)
            end)
            for model, hl in pairs(botEspObjects) do
                if not seenBots[model] or not model or not model.Parent then
                    removeBotEsp(model)
                end
            end
        end)
    end

    -- ==================== СУНДУКИ ====================
    local function scanChests()
        local char = player.Character
        if not char then return false, "Нет персонажа" end
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return false, "Нет RootPart" end

        local allPrompts = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local parent = obj.Parent
                if parent then
                    local rootPart = parent:IsA("BasePart") and parent
                        or parent:FindFirstChildWhichIsA("BasePart", true)
                    if rootPart then
                        table.insert(allPrompts, {
                            prompt = obj,
                            part = rootPart,
                            name = parent.Name,
                            hold = obj.HoldDuration or 0,
                            key = obj.KeyboardKeyCode or Enum.KeyCode.E,
                        })
                    end
                end
            end
        end

        if #allPrompts == 0 then
            return false, "На карте нет ProximityPrompt"
        end

        local groups = {}
        for _, e in ipairs(allPrompts) do
            local key = e.name .. "|" .. tostring(e.hold) .. "|" .. tostring(e.key)
            groups[key] = groups[key] or { name = e.name, hold = e.hold, key = e.key, entries = {} }
            table.insert(groups[key].entries, e)
        end

        local bestKey, bestGroup = nil, nil
        for k, g in pairs(groups) do
            if not bestGroup or #g.entries > #bestGroup.entries then
                bestKey, bestGroup = k, g
            end
        end

        local nearPrompt = nil
        local nearDist = math.huge
        for _, e in ipairs(allPrompts) do
            local d = (myRoot.Position - e.part.Position).Magnitude
            if d < nearDist and d < 20 then
                nearDist = d
                nearPrompt = e
            end
        end
        if nearPrompt then
            local nk = nearPrompt.name .. "|" .. tostring(nearPrompt.hold) .. "|" .. tostring(nearPrompt.key)
            if groups[nk] and #groups[nk].entries >= #bestGroup.entries then
                bestKey, bestGroup = nk, groups[nk]
            end
        end

        chestsList = {}
        for _, e in ipairs(bestGroup.entries) do
            table.insert(chestsList, {
                part = e.part,
                prompt = e.prompt,
                holdDuration = e.hold,
                key = e.key,
            })
        end

        table.sort(chestsList, function(a, b)
            return (myRoot.Position - a.part.Position).Magnitude
                 < (myRoot.Position - b.part.Position).Magnitude
        end)

        savedChestName = bestGroup.name
        savedHoldDuration = bestGroup.hold
        currentChestIndex = 1

        local total = #chestsList
        local otherGroups = 0
        for _, g in pairs(groups) do
            if g ~= bestGroup then otherGroups = otherGroups + #g.entries end
        end

        return true, string.format(
            "%s | %d шт. по всей карте%s",
            bestGroup.name, total,
            otherGroups > 0 and (" (+" .. otherGroups .. " др. типов)") or ""
        )
    end

