                    local hum = botTarget:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local targetRoot = botTarget:FindFirstChild("HumanoidRootPart") or botTarget:FindFirstChild("Torso") or botTarget:FindFirstChild("UpperTorso")
                        if targetRoot then
                            valid = true
                            local look = targetRoot.CFrame.LookVector
                            if look.Magnitude < 0.1 then look = (targetRoot.Position - myRoot.Position).Unit end
                            local pos = targetRoot.Position - (look * botDistance)
                            myRoot.CFrame = CFrame.new(Vector3.new(pos.X, targetRoot.Position.Y, pos.Z))
                            if botAimEnabled then
                                local targetPos = targetRoot.Position - Vector3.new(0, 0.8, 0)
                                cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos)
                            end
                        end
                    end
                end
                if not valid then
                    local newTarget = findNearestBotWithName(botTargetName)
                    if newTarget then botTarget = newTarget else botTarget = nil end
                end
            end
        end

        if espRainbow then
            local c = Color3.fromHSV((tick() % 1), 1, 1)
            for _, esp in ipairs(espObjects) do
                if esp and esp.Parent then esp.FillColor = c end
            end
        end

        if botEspRainbow then
            local c = Color3.fromHSV((tick() % 1), 1, 1)
            for _, hl in pairs(botEspObjects) do
                if hl and hl.Parent then hl.FillColor = c end
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(0.5)
            if botEspEnabled then
                pcall(updateBotEsp)
                pcall(refreshBotTpList)
            end
        end
    end)

    runService.Heartbeat:Connect(function()
        if shieldEnabled then
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                if shieldTargets == "all" or shieldTargets == "players" then
                    for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
                        if otherPlayer ~= player and otherPlayer.Character then
                            local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if otherRoot then
                                local dist = (myRoot.Position - otherRoot.Position).Magnitude
                                if dist < SHIELD_RADIUS then
                                    local direction = (myRoot.Position - otherRoot.Position).Unit
                                    local newPos = otherRoot.Position + (direction * SHIELD_RADIUS)
                                    myRoot.CFrame = CFrame.new(Vector3.new(newPos.X, myRoot.Position.Y, newPos.Z))
                                    break
                                end
                            end
                        end
                    end
                end
                if shieldTargets == "all" or shieldTargets == "bots" then
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj ~= player.Character then
                            local hum = obj:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 then
                                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                                if root then
                                    local dist = (myRoot.Position - root.Position).Magnitude
                                    if dist < SHIELD_RADIUS then
                                        local direction = (myRoot.Position - root.Position).Unit
                                        local newPos = root.Position + (direction * SHIELD_RADIUS)
                                        myRoot.CFrame = CFrame.new(Vector3.new(newPos.X, myRoot.Position.Y, newPos.Z))
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    player.CharacterAdded:Connect(function()
        if noclipEnabled then
            task.wait(0.5)
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    end)

    -- ГОРЯЧИЕ КЛАВИШИ
    uis.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        local key = input.KeyCode

        if key == macroRecKey then
            if macroRecording then
                stopRecording(true, macroNameValue)
            else
                startRecording()
            end
            return
        end
        if key == macroStopKey then
            if macroRecording then
                stopRecording(true, macroNameValue)
            elseif macroPlaying then
                stopPlaying()
            end
            return
        end
        if key == macroPlayKey then
            if macroPlaying then
                stopPlaying()
            elseif macroSelected and macroSelected ~= "(нет макросов)" then
                local data = loadMacroFromDisk(macroSelected)
                if data and data.events then
                    startPlaying(data.events, macroPlaySpeed, macroLoop)
                end
            end
            return
        end

        if key == Enum.KeyCode.Z then
            doPvpTeleport()
            return
        end

        if key == Enum.KeyCode.Two then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then savedPositions[1] = root.Position end
            end
        elseif key == Enum.KeyCode.Three then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then savedPositions[2] = root.Position end
            end
        elseif key == Enum.KeyCode.Four then
            if savedPositions[1] then
                local char = player.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then root.CFrame = CFrame.new(savedPositions[1]) end
                end
            end
        elseif key == Enum.KeyCode.Five then
            if savedPositions[2] then
                local char = player.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then root.CFrame = CFrame.new(savedPositions[2]) end
                end
            end
        end
    end)

    Fluent:Notify({
        Title = "KSAS ULTIMATE v8.3",
        Content = "Загружено! Макросы: F1=rec, F2=stop, F3=play",
        Duration = 5
    })

    print("KSAS ULTIMATE v8.3 загружен!")
end

