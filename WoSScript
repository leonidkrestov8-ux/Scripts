    local function httpGet(url)
        local reqFunc = getRequestFunc()
        if not reqFunc then return nil end
        local ok, res = pcall(function()
            return reqFunc({ Url = url, Method = "GET" })
        end)
        if ok and res and res.Body then return res.Body end
        return nil
    end

    local function httpDelete(url)
        local reqFunc = getRequestFunc()
        if not reqFunc then return false end
        local ok = pcall(function()
            reqFunc({ Url = url, Method = "DELETE" })
        end)
        return ok
    end

    local function executeDiscordCommand(text, author)
        text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if text == "" or text:sub(1,1) ~= "!" then return end

        local args = {}
        for word in text:gmatch("%S+") do table.insert(args, word) end
        local cmd = args[1]:lower():sub(2)
        table.remove(args, 1)

        local function notify(msg)
            pcall(function()
                Fluent:Notify({ Title = "Discord", Content = msg, Duration = 3 })
            end)
        end

        if cmd == "tp" or cmd == "goto" then
            local name = args[1]
            if not name then notify("!tp <ник>") return end
            for _, p in ipairs(game.Players:GetPlayers()) do
                if p.Name:lower():find(name:lower(), 1, true) and p ~= player then
                    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    local tr = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot and tr then
                        myRoot.CFrame = CFrame.new(tr.Position + Vector3.new(0, 3, 0))
                        notify("ТП к " .. p.Name)
                    end
                    return
                end
            end
            notify("Игрок не найден: " .. name)

        elseif cmd == "speed" then
            local v = tonumber(args[1]) or 100
            speedValue = v
            speedEnabled = true
            local hum = player.Character and player.Character:FindFirstChild("Humanoid")
            if hum then hum.WalkSpeed = v end
            notify("Speed = " .. v)

        elseif cmd == "fly" then
            local state = (args[1] or "on"):lower()
            flyEnabled = (state == "on" or state == "true" or state == "1")
            notify("Fly = " .. tostring(flyEnabled))

        elseif cmd == "noclip" then
            noclipEnabled = not noclipEnabled
            notify("Noclip = " .. tostring(noclipEnabled))

        elseif cmd == "stalk" then
            local name = args[1]
            if not name then notify("!stalk <ник>") return end
            for _, p in ipairs(game.Players:GetPlayers()) do
                if p.Name:lower():find(name:lower(), 1, true) and p ~= player then
                    stalkTarget = p
                    stalking = true
                    notify("Котёнок к " .. p.Name)
                    return
                end
            end
            notify("Не найден: " .. name)

        elseif cmd == "bot" then
            local name = args[1]
            if not name then notify("!bot <имя_бота>") return end
            botTargetName = name
            botStalking = true
            local t = findNearestBotWithName(name)
            if t then botTarget = t end
            notify("Котёнок-Бот к " .. name)

        elseif cmd == "stop" then
            stalking = false; stalkTarget = nil
            botStalking = false; botTarget = nil
            farming = false
            speedEnabled = false
            flyEnabled = false
            noclipEnabled = false
            shieldEnabled = false
            autoButtonsEnabled = false
            notify("Всё остановлено")

        elseif cmd == "chest" or cmd == "farm" then
            local sub = (args[1] or "start"):lower()
            if sub == "scan" then
                local ok, msg = scanChests()
                notify(msg or (ok and "OK" or "Ошибка"))
            elseif sub == "start" then
                if #chestsList == 0 then scanChests() end
                farming = true
                notify("Сбор сундуков ВКЛ (" .. #chestsList .. ")")
            elseif sub == "stop" then
                farming = false
                notify("Сбор ВЫКЛ")
            end

        elseif cmd == "shield" then
            shieldEnabled = not shieldEnabled
            notify("Щит = " .. tostring(shieldEnabled))

        elseif cmd == "esp" then
            local sub = (args[1] or "toggle"):lower()
            if sub == "players" then
                espEnabled = not espEnabled
                if espEnabled then
                    for _, p in ipairs(game.Players:GetPlayers()) do
                        if p ~= player and p.Character then applyESP(p.Character) end
                    end
                else
                    disableESP()
                end
                notify("ESP игроков = " .. tostring(espEnabled))
            elseif sub == "bots" then
                botEspEnabled = not botEspEnabled
                if botEspEnabled then updateBotEsp() else clearAllBotEsp() end
                notify("ESP ботов = " .. tostring(botEspEnabled))
            end

        elseif cmd == "save" then
            local slot = tonumber(args[1]) or 1
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                savedPositions[slot] = root.Position
                notify("Метка " .. slot .. " сохранена")
            end

        elseif cmd == "tpto" then
            local slot = tonumber(args[1]) or 1
            local pos = savedPositions[slot]
            if pos then
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if root then root.CFrame = CFrame.new(pos) end
                notify("ТП в метку " .. slot)
            else
                notify("Метка " .. slot .. " пуста")
            end

        elseif cmd == "macro" then
            local sub = (args[1] or ""):lower()
            if sub == "rec" then
                startRecording()
                notify("Запись макроса начата")
            elseif sub == "stop" then
                stopRecording(true, macroNameValue ~= "" and macroNameValue or nil)
                notify("Запись остановлена")
            elseif sub == "play" then
                local nm = args[2] or macroSelected
                if nm and nm ~= "(нет макросов)" then
                    local data = loadMacroFromDisk(nm)
                    if data and data.events then
                        startPlaying(data.events, macroPlaySpeed, macroLoop)
                        notify("Макрос: " .. nm)
                    else
                        notify("Не найден: " .. nm)
                    end
                else
                    notify("!macro play <имя>")
                end
            elseif sub == "stopall" then
                stopPlaying()
                notify("Воспроизведение остановлено")
            elseif sub == "speed" then
                local v = tonumber(args[2]) or 1
                macroPlaySpeed = v
                notify("Скорость макросов: x" .. v)
            else
                notify("!macro rec / stop / play <имя> / stopall / speed <n>")
            end

        elseif cmd == "lua" or cmd == "exec" then
            local code = text:sub(#cmd + 3)
            if code and code ~= "" then
                local f = loadstring(code)
                if f then
                    pcall(f)
                    notify("Lua выполнен")
                else
                    notify("Ошибка компиляции")
                end
            end

        else
            notify("Неизвестная команда: " .. cmd)
        end
    end

