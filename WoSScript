runService.RenderStepped:Connect(function()
    if stalking and stalkTarget then
        local char = stalkTarget.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local targetRoot = char:FindFirstChild("HumanoidRootPart")
                local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if targetRoot and myRoot then
                    local look = targetRoot.CFrame.LookVector
                    if look.Magnitude < 0.1 then look = (targetRoot.Position - myRoot.Position).Unit end
                    local pos = targetRoot.Position - (look * STALK_DISTANCE)
                    myRoot.CFrame = CFrame.new(Vector3.new(pos.X, targetRoot.Position.Y, pos.Z))
                end
            else
                stalking = false stalkTarget = nil
            end
        else
            stalking = false stalkTarget = nil
        end
    end

    if botStalking and botTargetName then
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local valid = false
            if botTarget and botTarget.Parent then
                local hum = botTarget:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local targetRoot = botTarget:FindFirstChild("HumanoidRootPart") or botTarget:FindFirstChild("Torso") or botTarget:FindFirstChild("UpperTorso")
                    if targetRoot then
                        valid = true
                        local look = targetRoot.CFrame.LookVector
                        if look.Magnitude < 0.1 then look = (targetRoot.Position - myRoot.Position).Unit end
                        local pos = targetRoot.Position - (look * botDistance)
                        myRoot.CFrame = CFrame.new(Vector3.new(pos.X, targetRoot.Position.Y, pos.Z))
                        if botAimEnabled then
                            local targetPos = targetRoot.Position - Vector3.new(0, 0.8, 0)
                            cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos)
                        end
                    end
                end
            end
            if not valid then
                local newTarget = findNearestBotWithName(botTargetName)
                if newTarget then botTarget = newTarget else botTarget = nil end
            end
        end
    end

    if rainbowMode then
        rainbowColor = (rainbowColor + 0.01) % 1
        local c = Color3.fromHSV(rainbowColor, 1, 1)
        for _, esp in ipairs(espObjects) do
            if esp and esp.Parent then esp.FillColor = c end
        end
    end
end)

