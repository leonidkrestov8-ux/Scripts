    local function updateBotEsp()
        if not botEspEnabled then return end
        
        pcall(function()
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end
            
            local myPos = myRoot.Position
            local seenBots = {}
            botEspList = {}
            local count = 0
            
            for _, obj in ipairs(workspace:GetDescendants()) do
                if count >= BOT_ESP_LIMIT then break end
                
                if obj and obj.Parent and obj:IsA("Model") and obj ~= player.Character and not isPlayerCharacter(obj) then
                    local hum = obj:FindFirstChild("Humanoid")
                    if hum and hum.Health and hum.Health > 0 then
                        local botRoot = obj:FindFirstChild("HumanoidRootPart") 
                            or obj:FindFirstChild("Torso") 
                            or obj:FindFirstChild("UpperTorso")
                        if botRoot and botRoot.Position then
                            local dist = (myPos - botRoot.Position).Magnitude
                            if dist <= botEspRadius and botHasE(obj) then
                                count = count + 1
                                seenBots[obj] = true
                                table.insert(botEspList, {model = obj, root = botRoot, distance = dist})
                                if not botEspObjects[obj] then
                                    addBotEsp(obj)
                                else
                                    pcall(function()
                                        if botEspObjects[obj] and botEspObjects[obj].Parent then
                                            botEspObjects[obj].FillColor = botEspColor
                                        end
                                    end)
                                end
                            end
                        end
                    end
                end
            end
            
            pcall(function()
                table.sort(botEspList, function(a, b) return a.distance < b.distance end)
            end)
            
            for model, hl in pairs(botEspObjects) do
                if not seenBots[model] or not model or not model.Parent then
                    removeBotEsp(model)
                end
            end
        end)
    end

    -- ==================== СУНДУКИ ====================
    local function scanChests()
        local char = player.Character
        if not char then return false, "Нет персонажа" end
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return false, "Нет RootPart" end
        
        local nearestPrompt, nearestDist = nil, math.huge
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local parent = obj.Parent
                if parent then
                    local rootPart = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                    if rootPart then
                        local d = (myRoot.Position - rootPart.Position).Magnitude
                        if d < nearestDist and d < 15 then
                            nearestDist = d
                            nearestPrompt = obj
                        end
                    end
                end
            end
        end
        
        if not nearestPrompt then return false, "Не нашёл сундук рядом" end
        
        savedChestName = nearestPrompt.Parent.Name
        savedHoldDuration = nearestPrompt.HoldDuration or 0
        
        chestsList = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent.Name == savedChestName then
                local parentHold = obj.HoldDuration or 0
                local sameType = false
                if savedHoldDuration > 0 and parentHold > 0 then sameType = true
                elseif savedHoldDuration == 0 and parentHold == 0 then sameType = true end
                
                if sameType then
                    local parent = obj.Parent
                    local rootPart = parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart")
                    if rootPart then
                        table.insert(chestsList, {part = rootPart, prompt = obj, holdDuration = parentHold})
                    end
                end
            end
        end
        
        currentChestIndex = 1
        return true, savedChestName .. " | " .. #chestsList .. " шт."
    end

