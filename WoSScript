    -- ==================== МАКРОСЫ ====================
    local function sanitizeName(n)
        return (tostring(n or ""):gsub("[^%w_%-]", "_"))
    end

    local function macroPath(name)
        return MACROS_FOLDER .. "/" .. sanitizeName(name) .. ".json"
    end

    local function refreshMacroList()
        macroList = {}
        if not hasFS then return end
        local ok, files = pcall(listfiles, MACROS_FOLDER)
        if not ok or not files then return end
        for _, p in ipairs(files) do
            if string.sub(p, -5) == ".json" then
                local nm = string.match(p, "([^\\/]+)%.json$")
                if nm then table.insert(macroList, nm) end
            end
        end
        table.sort(macroList)
    end

    local function saveMacroToDisk(name, events)
        if not hasFS then return false end
        name = sanitizeName(name)
        if name == "" then return false end
        local data = {
            events = events,
            duration = (#events > 0) and events[#events].t or 0,
            savedAt = os.time(),
        }
        local ok = pcall(writefile, macroPath(name), httpService:JSONEncode(data))
        if ok then refreshMacroList() end
        return ok
    end

    local function loadMacroFromDisk(name)
        if not hasFS then return nil end
        name = sanitizeName(name)
        local path = macroPath(name)
        if not isfile(path) then return nil end
        local ok, content = pcall(readfile, path)
        if not ok or not content or content == "" then return nil end
        local ok2, data = pcall(function() return httpService:JSONDecode(content) end)
        if not ok2 or type(data) ~= "table" then return nil end
        return data
    end

    local function deleteMacroFromDisk(name)
        if not hasFS then return end
        name = sanitizeName(name)
        local path = macroPath(name)
        if isfile(path) then
            pcall(delfile, path)
            refreshMacroList()
        end
    end

    local function moveCursorAbs(x, y)
        if mousemoveabs then
            local ok = pcall(mousemoveabs, x, y)
            if ok then return true end
        end
        if setmousepos then
            local ok = pcall(setmousepos, x, y)
            if ok then return true end
        end
        if syn and syn.mousemoverel then
            local cur = uis:GetMouseLocation()
            local ok = pcall(syn.mousemoverel, x - cur.X, y - cur.Y)
            if ok then return true end
        end
        if mousemoverel then
            local cur = uis:GetMouseLocation()
            local ok = pcall(mousemoverel, x - cur.X, y - cur.Y)
            if ok then return true end
        end
        pcall(function() vim:SendMouseMoveEvent(x, y, game) end)
        return false
    end

    local function vimClick(btn, down)
        if btn == "MouseButton1" then
            if down then
                if mouse1down then pcall(mouse1down)
                else pcall(function() vim:SendMouseButtonEvent(0,0,0,true,game,1) end) end
            else
                if mouse1up then pcall(mouse1up)
                else pcall(function() vim:SendMouseButtonEvent(0,0,0,false,game,1) end) end
            end
        elseif btn == "MouseButton2" then
            if down then
                if mouse2down then pcall(mouse2down)
                else pcall(function() vim:SendMouseButtonEvent(0,0,1,true,game,1) end) end
            else
                if mouse2up then pcall(mouse2up)
                else pcall(function() vim:SendMouseButtonEvent(0,0,1,false,game,1) end) end
            end
        elseif btn == "MouseButton3" then
            if down then
                if mouse3down then pcall(mouse3down)
                else pcall(function() vim:SendMouseButtonEvent(0,0,2,true,game,1) end) end
            else
                if mouse3up then pcall(mouse3up)
                else pcall(function() vim:SendMouseButtonEvent(0,0,2,false,game,1) end) end
            end
        end
    end

    local function playMacroOnce(events, speed)
        speed = math.max(0.05, tonumber(speed) or 1)
        local t0 = tick()
        for _, ev in ipairs(events) do
            if not macroPlaying then return end
            local target = ev.t / speed
            while macroPlaying and (tick() - t0) < target do
                task.wait(0.001)
            end
            if not macroPlaying then return end

            if ev.type == "move" then
                moveCursorAbs(ev.x, ev.y)
            elseif ev.type == "down" then
                moveCursorAbs(ev.x, ev.y)
                task.wait(0.005)
                vimClick(ev.button, true)
            elseif ev.type == "up" then
                moveCursorAbs(ev.x, ev.y)
                task.wait(0.005)
                vimClick(ev.button, false)
            end
        end
    end

    local function startPlaying(events, speed, loop)
        if macroPlaying then return end
        if not events or #events == 0 then
            Fluent:Notify({ Title = "Макрос", Content = "Пустой макрос", Duration = 2 })
            return
        end
        macroPlaying = true
        local myToken = playingToken + 1
        playingToken = myToken
        Fluent:Notify({
            Title = "Макрос",
            Content = string.format("Скорость x%.2f %s", speed, loop and "(loop)" or ""),
            Duration = 2
        })
        task.spawn(function()
            repeat
                playMacroOnce(events, speed)
                if not macroLoop then break end
                task.wait(0.05)
            until (not macroPlaying) or (playingToken ~= myToken) or (not macroLoop)
            if playingToken == myToken then
                macroPlaying = false
                Fluent:Notify({ Title = "Макрос", Content = "Воспроизведение завершено", Duration = 2 })
            end
        end)
    end

    local function stopPlaying()
        if not macroPlaying then return end
        macroPlaying = false
        playingToken = playingToken + 1
        Fluent:Notify({ Title = "Макрос", Content = "Остановлен", Duration = 2 })
    end

    local function startRecording()
        if macroRecording then return end
        if macroPlaying then
            Fluent:Notify({ Title = "Макрос", Content = "Сначала останови воспроизведение", Duration = 2 })
            return
        end
        macroEvents = {}
        macroStartTime = tick()
        macroRecording = true

        if recordingConn then recordingConn:Disconnect() end
        if recordingEndConn then recordingEndConn:Disconnect() end
        if recordingMoveConn then recordingMoveConn:Disconnect() end

        recordingConn = uis.InputBegan:Connect(function(input, gpe)
            if not macroRecording then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                local pos = uis:GetMouseLocation()
                table.insert(macroEvents, {
                    t = tick() - macroStartTime,
                    type = "down",
                    button = input.UserInputType.Name,
                    x = pos.X, y = pos.Y
                })
            end
        end)

        recordingEndConn = uis.InputEnded:Connect(function(input)
            if not macroRecording then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                local pos = uis:GetMouseLocation()
                table.insert(macroEvents, {
                    t = tick() - macroStartTime,
                    type = "up",
                    button = input.UserInputType.Name,
                    x = pos.X, y = pos.Y
                })
            end
        end)

        local lastX, lastY = -1000, -1000
        recordingMoveConn = runService.RenderStepped:Connect(function()
            if not macroRecording then return end
            local pos = uis:GetMouseLocation()
            local x, y = math.floor(pos.X), math.floor(pos.Y)
            if x ~= lastX or y ~= lastY then
                table.insert(macroEvents, {
                    t = tick() - macroStartTime,
                    type = "move",
                    x = x, y = y
                })
                lastX, lastY = x, y
            end
        end)

        Fluent:Notify({
            Title = "Запись",
            Content = "Пишу мышь (" .. macroStopKey.Name .. " - стоп)",
            Duration = 3
        })
    end

    local function stopRecording(save, name)
        if not macroRecording then return end
        macroRecording = false
        if recordingConn then recordingConn:Disconnect() recordingConn = nil end
        if recordingEndConn then recordingEndConn:Disconnect() recordingEndConn = nil end
        if recordingMoveConn then recordingMoveConn:Disconnect() recordingMoveConn = nil end

        local dur = (#macroEvents > 0) and macroEvents[#macroEvents].t or 0
        Fluent:Notify({
            Title = "Запись",
            Content = string.format("Стоп. Событий: %d, %.2f сек", #macroEvents, dur),
            Duration = 3
        })

        if save and #macroEvents > 0 then
            if not name or name == "" then
                name = "macro_" .. tostring(os.time())
            end
            if saveMacroToDisk(name, macroEvents) then
                Fluent:Notify({ Title = "Макрос", Content = "Сохранён: " .. sanitizeName(name), Duration = 3 })
            else
                Fluent:Notify({ Title = "Макрос", Content = "Ошибка сохранения", Duration = 3 })
            end
        end
    end

