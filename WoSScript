-- ==================== ФУНКЦИИ ====================
local function applyESP(char)
    if not char then return end
    local oldHl = char:FindFirstChild("XenoESP")
    if oldHl then oldHl:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "XenoESP"
    hl.Adornee = char
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    table.insert(espObjects, hl)
end

local function disableESP()
    for _, esp in ipairs(espObjects) do
        if esp and esp.Parent then esp:Destroy() end
    end
    espObjects = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "XenoESP" then obj:Destroy() end
    end
end

local function findNearestBotWithName(name)
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == name and obj ~= player.Character then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
                if root then
                    local d = (myRoot.Position - root.Position).Magnitude
                    if d < nearestDist then nearestDist = d nearest = obj end
                end
            end
        end
    end
    return nearest
end

-- ==================== ESP БОТОВ (ФИКС) ====================
local function isPlayerCharacter(model)
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p.Character == model then return true end
    end
    return false
end

local function botHasE(botModel)
    for _, obj in ipairs(botModel:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            if obj.Enabled and obj.MaxActivationDistance > 0 then
                return true
            end
        end
    end
    return false
end

local function botMatchesFilter(botModel)
    if botEspFilter == "all" then return true
    elseif botEspFilter == "withE" then return botHasE(botModel)
    elseif botEspFilter == "noE" then return not botHasE(botModel) end
    return false
end

local function addBotEsp(botModel)
    if botEspObjects[botModel] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "XenoBotESP"
    hl.Adornee = botModel
    hl.FillColor = botEspColor
    hl.FillTransparency = 0.4
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = botModel
    botEspObjects[botModel] = hl
end

local function removeBotEsp(botModel)
    if botEspObjects[botModel] then
        if botEspObjects[botModel].Parent then botEspObjects[botModel]:Destroy() end
        botEspObjects[botModel] = nil
    end
end

local function clearAllBotEsp()
    for model, hl in pairs(botEspObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    botEspObjects = {}
    botEspList = {}
end

local function updateBotEsp()
    if not botEspEnabled then return end
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position
    local seenBots = {}
    botEspList = {}
    
    -- ФИКС: GetDescendants() вместо GetChildren()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= player.Character and not isPlayerCharacter(obj) then
            local hum = obj:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local botRoot = obj:FindFirstChild("HumanoidRootPart") 
                    or obj:FindFirstChild("Torso") 
                    or obj:FindFirstChild("UpperTorso")
                if botRoot then
                    local dist = (myPos - botRoot.Position).Magnitude
                    if dist <= botEspRadius and botMatchesFilter(obj) then
                        seenBots[obj] = true
                        table.insert(botEspList, {model = obj, root = botRoot, distance = dist})
                        if not botEspObjects[obj] then
                            addBotEsp(obj)
                        else
                            botEspObjects[obj].FillColor = botEspColor
                        end
                    end
                end
            end
        end
    end
    
    table.sort(botEspList, function(a, b) return a.distance < b.distance end)
    
    for model, hl in pairs(botEspObjects) do
        if not seenBots[model] or not model.Parent then
            removeBotEsp(model)
        end
    end
end

